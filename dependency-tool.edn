{:source-paths ["src"]
 :component-rules [{:component :acceptance :match "empire.application.acceptance-harness"}
                   {:component :application :match "empire.application*"}
                   {:component :domain :match "empire.domain*"}
                   {:component :acceptance :match "empire.adapters.runtime.acceptance-engine"}
                   {:component :adapters :match "empire.adapters*"}
                   {:component :architecture :match "empire.architecture*"}
                   {:component :atoms :match "empire.atoms*"}
                   {:component :ui :match "empire.ui*"}
                   {:component :game-loop :match "empire.game-loop*"}
                   {:component :computer :match ["empire.computer" "empire.computer*"]}
                   {:component :movement :match ["empire.movement" "empire.movement*"]}
                   {:component :player :match ["empire.player" "empire.player*"]}
                   {:component :units :match ["empire.units" "empire.units*"]}
                   {:component :containers :match ["empire.containers" "empire.containers*"]}
                   {:component :combat :match ["empire.combat" "empire.combat*"]}
                   {:component :debug :match ["empire.debug" "empire.debug*"]}
                   {:component :config :match "empire.config"}
                   {:component :init :match "empire.init"}
                   {:component :map :match "empire.map"}
                   {:component :repair :match "empire.repair"}
                   {:component :save-load :match "empire.save-load"}
                   {:component :test-utils :match "empire.test-utils"}
                   {:component :acceptance-parser :match "empire.acceptance.parser*"}
                   {:component :acceptance-generator :match "empire.acceptance.generator*"}
                   {:component :acceptance :match "empire.acceptance*"}]
 :forbidden-dependencies [[:application :atoms]
                          [:application :ui]
                          [:application :game-loop]
                          [:application :test-utils]
                          [:application :acceptance-parser]
                          [:application :acceptance-generator]
                          [:application :acceptance]
                          [:domain :atoms]
                          [:domain :ui]
                          [:domain :game-loop]
                          [:domain :test-utils]
                          [:domain :application]
                          [:domain :adapters]
                          [:domain :computer]
                          [:domain :movement]
                          [:domain :player]
                          [:domain :combat]
                          [:domain :debug]
                          [:domain :save-load]
                          [:domain :init]
                          [:domain :acceptance]
                          [:domain :acceptance-parser]
                          [:domain :acceptance-generator]
                          [:adapters :acceptance-parser]
                          [:adapters :acceptance-generator]
                          [:adapters :acceptance]
                          [:units :atoms]
                          [:units :adapters]
                          [:units :domain]
                          [:units :ui]
                          [:units :game-loop]
                          [:units :computer]
                          [:units :movement]
                          [:units :player]
                          [:units :combat]
                          [:units :debug]
                          [:units :save-load]
                          [:units :init]
                          [:units :acceptance]
                          [:units :acceptance-parser]
                          [:units :acceptance-generator]
                          [:save-load :atoms]
                          [:save-load :ui]
                          [:save-load :game-loop]
                          [:save-load :acceptance]
                          [:save-load :acceptance-parser]
                          [:save-load :acceptance-generator]
                          [:init :atoms]
                          [:init :ui]
                          [:init :game-loop]
                          [:init :save-load]
                          [:init :acceptance]
                          [:init :acceptance-parser]
                          [:init :acceptance-generator]
                          [:config :atoms]
                          [:config :adapters]
                          [:config :ui]
                          [:config :game-loop]
                          [:config :computer]
                          [:config :movement]
                          [:config :player]
                          [:config :combat]
                          [:config :debug]
                          [:config :save-load]
                          [:config :init]
                          [:config :acceptance]
                          [:config :acceptance-parser]
                          [:config :acceptance-generator]]
 :fail-on-cycles false
 :fail-on-violations true}
