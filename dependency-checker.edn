{:source-paths ["src"]
 :component-rules
 [{:component :config
   :kind :concrete
   :match ["^empire\\.config(\\..+)?$"
           "^empire\\.units(\\..*)?$"
           "empire.domain.core.unit-metrics"]}

  {:component :inner-ring
   :kind :concrete
   :match ["^empire\\.domain\\.core(\\.(?!impl\\.).*)?$"
           "^empire\\.domain\\.model(\\..*)?$"]}

  {:component :state
   :kind :concrete
   :match ["^empire\\.state(\\..*)?$"
           "^empire\\.application\\.state(\\..*)?$"]}

  {:component :quil
   :kind :concrete
   :match "^empire\\.ui\\.quil(\\..*)?$"}

  {:component :ui
   :kind :concrete
   :match "^empire\\.ui\\.util(\\..*)?$"}

  {:component :application
   :kind :concrete
   :match "^empire\\.application(\\..*)?$"}

  {:component :domain-services
   :kind :concrete
   :match ["^empire\\.movement(\\..*)?$"
           "^empire\\.containers(\\..*)?$"
           "^empire\\.debug(\\..*)?$"
           "^empire\\.domain\\.services(\\..*)?$"]}

  {:component :use-cases
   :kind :concrete
   :match ["^empire\\.player(\\..*)?$"
           "^empire\\.computer(\\..*)?$"
           "^empire\\.game.loop(\\..*)?$"]}

  {:component :outer-ring
   :kind :concrete
   :match "empire.*"}]

 :forbidden-dependencies
 [[:inner-ring :outer-ring]
  [:inner-ring :application]
  [:inner-ring :domain-services]
  [:inner-ring :use-cases]
  [:inner-ring :state]
  [:ui :quil]
  [:domain-services :use-cases]
  [:domain-services :application]
  [:state :application]
  [:state :domain-services]
  [:state :use-cases]]

 ;; :ui and :outer-ring intentionally cycle — :ui is carved from :outer-ring
 ;; solely to enforce [:ui :quil]. The cycle is architectural intent.
 :fail-on-cycles false
 :fail-on-violations true}
