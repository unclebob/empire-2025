;; 5-layer / 7-component architecture
;; L5: ui
;; L4: round-mechanics  (game-loop, application)
;; L3: player, computer  (peers)
;; L2: shared-mechanics  (movement, containers, domain.services, debug)
;; L1: state, config     (peers)
;; Dependencies flow strictly downward.

{:source-paths ["src"]
 :component-rules
 [{:component :ui
   :kind :concrete
   :match "^empire\\.ui(\\..*)?$"}

  {:component :round-mechanics
   :kind :concrete
   :match ["^empire\\.game.loop(\\..*)?$"
           "^empire\\.application(\\.(?!state).*)?$"]}

  {:component :player
   :kind :concrete
   :match "^empire\\.player(\\..*)?$"}

  {:component :computer
   :kind :concrete
   :match "^empire\\.computer(\\..*)?$"}

  {:component :shared-mechanics
   :kind :concrete
   :match ["^empire\\.movement(\\..*)?$"
           "^empire\\.containers(\\..*)?$"
           "^empire\\.domain\\.services(\\..*)?$"
           "^empire\\.debug(\\..*)?$"]}

  {:component :state
   :kind :concrete
   :match ["^empire\\.state(\\..*)?$"
           "^empire\\.application\\.state(\\..*)?$"]}

  {:component :config
   :kind :concrete
   :match ["^empire\\.config(\\..*)?$"
           "^empire\\.units(\\..*)?$"
           "^empire\\.domain\\.core(\\..*)?$"
           "^empire\\.domain\\.model(\\..*)?$"]}

  {:component :test-infra
   :kind :concrete
   :match "empire.*"}]

 :forbidden-dependencies
 [;; L1 cannot depend on anything above
  [:config :state]
  [:config :shared-mechanics]
  [:config :player]
  [:config :computer]
  [:config :round-mechanics]
  [:config :ui]
  [:state :shared-mechanics]
  [:state :player]
  [:state :computer]
  [:state :round-mechanics]
  [:state :ui]

  ;; L2 cannot depend on L3+
  [:shared-mechanics :player]
  [:shared-mechanics :computer]
  [:shared-mechanics :round-mechanics]
  [:shared-mechanics :ui]

  ;; L3 cannot depend on L4+
  [:player :round-mechanics]
  [:player :ui]
  [:computer :round-mechanics]
  [:computer :ui]

  ;; L4 cannot depend on L5
  [:round-mechanics :ui]]

 :fail-on-cycles false
 :fail-on-violations true}
