;; 5-layer / 7-component architecture
;; L5: ui
;; L4: game        (loop, initialization, save-load, production-status)
;; L3: player, computer  (peers)
;; L2: game-mechanics  (movement, containers, services, debug)
;; L1: state, config   (peers)
;; Dependencies flow strictly downward.

{:source-paths ["src"]
 :component-rules
 [{:component :ui
   :kind :concrete
   :match "^empire\\.ui(\\..*)?$"}

  {:component :game
   :kind :concrete
   :match "^empire\\.game(\\..*)?$"}

  {:component :player
   :kind :concrete
   :match "^empire\\.player(\\..*)?$"}

  {:component :computer
   :kind :concrete
   :match "^empire\\.computer(\\..*)?$"}

  {:component :game-mechanics
   :kind :concrete
   :match "^empire\\.game-mechanics(\\..*)?$"}

  {:component :state
   :kind :concrete
   :match "^empire\\.state(\\..*)?$"}

  {:component :config
   :kind :concrete
   :match "^empire\\.config(\\..*)?$"}

  {:component :test-infra
   :kind :concrete
   :match "empire.*"}]

 :forbidden-dependencies
 [;; L1 cannot depend on anything above
  [:config :state]
  [:config :game-mechanics]
  [:config :player]
  [:config :computer]
  [:config :game]
  [:config :ui]
  [:state :game-mechanics]
  [:state :player]
  [:state :computer]
  [:state :game]
  [:state :ui]

  ;; L2 cannot depend on L3+
  [:game-mechanics :player]
  [:game-mechanics :computer]
  [:game-mechanics :game]
  [:game-mechanics :ui]

  ;; L3 cannot depend on L4+
  [:player :game]
  [:player :ui]
  [:computer :game]
  [:computer :ui]

  ;; L4 cannot depend on L5
  [:game :ui]]

 :fail-on-cycles false
 :fail-on-violations true}
