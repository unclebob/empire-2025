{:source-paths ["src"]
 :component-rules
 [{:component :config
   :kind :concrete
   :match ["^empire\\.config(\\..+)?$"
           "^empire\\.units(\\..*)?$"
           "empire.domain.core.unit-metrics"]}

  {:component :inner-ring
   :kind :concrete
   :match ["^empire\\.domain\\.core(\\.(?!impl\\.).*)?$"
           "^empire\\.domain\\.model(\\..*)?$"]}

  {:component :quil
   :kind :concrete
   :match "^empire\\.ui\\.quil(\\..*)?$"}

  {:component :ui
   :kind :concrete
   :match "^empire\\.ui\\.util(\\..*)?$"}

  ;; :application excludes empire.application.bootstrap, acceptance-harness,
  ;; and empire.adapters.runtime.acceptance-engine — these are composition roots
  ;; that legitimately wire across all layers, so they fall through to :outer-ring.
  {:component :application
   :kind :concrete
   :match ["^empire\\.application\\.(?!bootstrap$|acceptance.harness$).*$"
           "^empire\\.adapters\\.(?!runtime\\.acceptance.engine$).*$"]}

  {:component :domain-services
   :kind :concrete
   :match ["^empire\\.movement(\\..*)?$"
           "^empire\\.containers(\\..*)?$"
           "^empire\\.debug(\\..*)?$"
           "^empire\\.domain\\.services(\\..*)?$"]}

  {:component :use-cases
   :kind :concrete
   :match ["^empire\\.player(\\..*)?$"
           "^empire\\.computer(\\..*)?$"
           "^empire\\.game.loop(\\..*)?$"]}

  {:component :outer-ring
   :kind :concrete
   :match "empire.*"}]

 :forbidden-dependencies
 [[:inner-ring :outer-ring]
  [:inner-ring :application]
  [:inner-ring :domain-services]
  [:inner-ring :use-cases]
  [:ui :quil]
  [:domain-services :use-cases]
  [:application :use-cases]
  [:application :domain-services]]

 ;; :ui and :outer-ring intentionally cycle — :ui is carved from :outer-ring
 ;; solely to enforce [:ui :quil]. The cycle is architectural intent.
 :fail-on-cycles false
 :fail-on-violations true}
